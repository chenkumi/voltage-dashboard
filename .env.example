# Voltage Dashboard can run locally without environment variables.
# Copy this file to .env only when the surrounding WebMCP host requires settings.
# Never commit real keys, tokens, private URLs, or production credentials.

VITE_APP_PROVIDER=
VITE_APP_AUTH_KEY=
VITE_APP_LLM_BASE_URL=
VITE_APP_LLM_MODEL=
VITE_APP_LLM_THINKING_LEVEL=
VITE_APP_BASE_URL=
VITE_APP_HOST=
